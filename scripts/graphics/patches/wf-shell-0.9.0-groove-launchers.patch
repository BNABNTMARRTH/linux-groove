+            if (id == "thunar" || id == "Thunar") return "files";
+            if (id == "mousepad" || id == "org.xfce.mousepad") return "editor";
+            if (id == "firefox" || id == "firefox-default" || id == "org.mozilla.firefox") return "browser";
+        }
+        return "";
+    }
+
+    void refresh_pins()
+    {
+        int position = 0;
+        for (auto& pin : pins)
+        {
+            bool running = false;
+            for (auto& app : applications)
+            {
+                if (app.second != pin.first) continue;
+                running = true;
+                box.reorder_child(*app.first, position++);
+            }
+            box.reorder_child(*pin.second, position++);
+            pin.second->set_visible(!running);
+        }
+    }
