+static void
+dock_launcher_redraw_handler(struct widget *widget, void *data)
+{
+	struct dock_launcher *launcher = data;
+	struct rectangle allocation;
+	cairo_t *cr;
+
+	cr = widget_cairo_create(launcher->dock->widget);
+
+	widget_get_allocation(widget, &allocation);
+	int icon_w = cairo_image_surface_get_width(launcher->icon);
+	int icon_h = cairo_image_surface_get_height(launcher->icon);
+	int x = allocation.x + (allocation.width - icon_w) / 2;
+	int y = allocation.y + (allocation.height - icon_h) / 2;
+
+	if (launcher->pressed) {
+		y += 1;
+	}
+
+	if (launcher->focused) {
+		cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 0.16);
+		rounded_rect(cr, allocation.x, allocation.y,
+			     allocation.x + allocation.width,
+			     allocation.y + allocation.height, 12);
+		cairo_fill(cr);
+	}
+
+	cairo_set_source_surface(cr, launcher->icon, x, y);
+	cairo_paint(cr);
+
+	if (launcher->focused) {
+		cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 0.20);
+		cairo_mask_surface(cr, launcher->icon, x, y);
+	}
+
+	cairo_destroy(cr);
