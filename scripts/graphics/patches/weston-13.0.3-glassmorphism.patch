+static void
+dock_redraw_handler(struct widget *widget, void *data)
+{
+	cairo_surface_t *surface;
+	cairo_t *cr;
+	struct dock *dock = data;
+	double px = dock->pill_rect.x;
+	double py = dock->pill_rect.y;
+	double pw = dock->pill_rect.width;
+	double ph = dock->pill_rect.height;
+
+	cr = widget_cairo_create(dock->widget);
+
+	/* Clear outside pill so transparent */
+	cairo_set_operator(cr, CAIRO_OPERATOR_CLEAR);
+	cairo_paint(cr);
+
+	cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+
+	if (pw > 0 && ph > 0) {
+		rounded_rect(cr, px, py, px + pw, py + ph, 16);
+		cairo_set_source_rgba(cr, 0.125, 0.141, 0.169, 0.94);
+		cairo_fill_preserve(cr);
+		cairo_set_source_rgba(cr, 1, 1, 1, 0.10);
+		cairo_set_line_width(cr, 1.0);
+		cairo_stroke(cr);
+	}
+
+	cairo_destroy(cr);
+	surface = window_get_surface(dock->window);
+	cairo_surface_destroy(surface);
+	dock->painted = 1;
+	check_desktop_ready(dock->window);
+}
+
+static void
+dock_resize_handler(struct widget *widget,
+		    int32_t width, int32_t height, void *data)
+{
+	struct dock *dock = data;
+	struct dock_launcher *launcher;
+	int count = 0;
+	int icon_size = 40;
+	int icon_gap = 8;
+	int pad_h = 12;
+	int pill_height = 64;
+	int pill_width;
+	int pill_x, pill_y;
+	int cur_x;
+
+	wl_list_for_each(launcher, &dock->launcher_list, link)
+		count++;
+
+	if (count == 0)
+		return;
+
+	pill_width = (count * icon_size) + ((count - 1) * icon_gap) + (2 * pad_h);
+	pill_x = (width - pill_width) / 2;
+	pill_y = (height - pill_height) / 2;
+
+	dock->pill_rect.x = pill_x;
+	dock->pill_rect.y = pill_y;
+	dock->pill_rect.width = pill_width;
+	dock->pill_rect.height = pill_height;
+
+	widget_input_region_add(dock->widget, &dock->pill_rect);
+
+	cur_x = pill_x + pad_h;
+	int icon_y = pill_y + (pill_height - icon_size) / 2;
+
+	wl_list_for_each(launcher, &dock->launcher_list, link) {
+		widget_set_allocation(launcher->widget, cur_x, icon_y, icon_size, icon_size);
+		cur_x += icon_size + icon_gap;
+	}
+}
+
+static void
+dock_configure(void *data,
+	       struct weston_desktop_shell *desktop_shell,
+	       uint32_t edges, struct window *window,
+	       int32_t width, int32_t height)
+{
+	(void)data;
+	struct surface *surface = window_get_user_data(window);
+	struct dock *dock = container_of(surface, struct dock, base);
+	struct output *owner;
+
+	if (width < 1 || height < 1) {
+		owner = dock->owner;
+		dock_destroy(dock);
+		owner->dock = NULL;
+		return;
+	}
+
+	window_schedule_resize(dock->window, width, 74);
+}
+
+static void
+dock_add_launchers(struct dock *dock, struct desktop *desktop)
+{
+	struct weston_config_section *s;
+	char *icon, *path, *displayname;
+	const char *name;
+	int count = 0;
+
+	s = NULL;
+	while (weston_config_next_section(desktop->config, &s, &name)) {
+		if (strcmp(name, "launcher") != 0)
+			continue;
+
+		weston_config_section_get_string(s, "icon", &icon, NULL);
+		weston_config_section_get_string(s, "path", &path, NULL);
+		weston_config_section_get_string(s, "displayname", &displayname, NULL);
+		if (displayname == NULL && path != NULL)
+			displayname = xstrdup(basename(path));
+
+		if (icon != NULL && path != NULL) {
+			dock_add_launcher(dock, icon, path, displayname);
+			count++;
+		}
+		free(icon);
+		free(path);
+		free(displayname);
+	}
+
+	if (count == 0) {
+		dock_add_launcher(dock,
+				  "/usr/share/icons/groove-glass/terminal.png",
+				  BINDIR "/weston-terminal",
+				  "Terminal");
+	}
+}
+
+static struct dock *
+dock_create(struct desktop *desktop, struct output *output)
+{
+	struct dock *dock;
+
+	dock = xzalloc(sizeof *dock);
+	dock->owner = output;
+	dock->base.configure = dock_configure;
+	dock->window = window_create_custom(desktop->display);
+	dock->widget = window_add_widget(dock->window, dock);
+	wl_list_init(&dock->launcher_list);
+
+	window_set_title(dock->window, "dock");
+	window_set_user_data(dock->window, dock);
+
+	widget_set_redraw_handler(dock->widget, dock_redraw_handler);
+	widget_set_resize_handler(dock->widget, dock_resize_handler);
+	widget_set_transparent(dock->widget, 1);
+
+	dock_add_launchers(dock, desktop);
+
+	return dock;
+}
